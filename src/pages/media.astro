---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialFeed from '../components/SocialFeed.astro';
import CTABanner from '../components/CTABanner.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<BaseLayout
  title="Media & Resources | Valor Insurance Group — Insurance Tips & Education"
  description="Watch insurance tips, educational videos, read guides, and get industry updates from Patrick Henigan. YouTube, TikTok, Instagram content and blog articles to help you make smarter insurance decisions."
>
  <section class="pt-32 pb-8 px-4 bg-[#2D2D2D]">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-[#B8D430] text-sm font-semibold tracking-widest uppercase">Media & Resources</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">Insurance Education Made Simple</h1>
      <p class="text-[#9CA3AF] text-lg max-w-3xl mx-auto leading-relaxed">
        We believe the more you understand about insurance, the better decisions you'll make. Follow along for tips, insights, and real talk about protecting what matters.
      </p>
    </div>
  </section>

  <SocialFeed compact={false} />

  <!-- Blog Posts Section -->
  <section class="py-20 px-4 bg-[#1a1a1a]" id="blog">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-3">Insurance Blog</h2>
        <div class="accent-line-center w-24 mx-auto mb-4"></div>
        <p class="text-[#9CA3AF] text-lg">Straightforward guides, tips, and answers to the questions Colorado homeowners and business owners actually ask.</p>
      </div>
      <div class="space-y-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="block bg-[#2D2D2D] rounded-xl border border-[#4A4A4A] hover:border-[#B8D430] p-6 md:p-8 transition-all duration-300 group"
          >
            <div class="flex flex-col gap-3">
              <div class="flex flex-wrap items-center gap-3 text-sm text-[#9CA3AF]">
                <span>{new Date(post.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
                {post.data.readTime && (
                  <>
                    <span class="text-[#4A4A4A]">·</span>
                    <span>{post.data.readTime}</span>
                  </>
                )}
              </div>
              <h3 class="text-xl md:text-2xl font-bold text-white group-hover:text-[#B8D430] transition-colors">
                {post.data.title}
              </h3>
              <p class="text-[#9CA3AF] leading-relaxed">{post.data.excerpt}</p>
              <span class="text-[#B8D430] font-medium text-sm group-hover:text-[#A6C22A] transition-colors">
                Read More →
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</BaseLayout>
