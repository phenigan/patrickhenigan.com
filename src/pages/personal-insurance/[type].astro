---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import { quoteLinks, siteConfig } from '../../data/siteData';
import { personalInsuranceDetails } from '../../data/insuranceDetails';

export function getStaticPaths() {
  return personalInsuranceDetails.map((type) => ({
    params: { type: type.slug },
    props: type,
  }));
}

const { slug, name, shortDescription, detailedDescription, keyFeatures, whoNeedsThis, faq } = Astro.props;
const pageUrl = `${siteConfig.site}/personal-insurance/${slug}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Personal Insurance', item: `${siteConfig.site}/personal-insurance/` },
    { '@type': 'ListItem', position: 3, name: name, item: pageUrl },
  ],
};

const faqSchema = faq.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
} : null;
---

<BaseLayout
  title={`${name} | Personal Insurance | Valor Insurance Group`}
  description={shortDescription}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {faqSchema && <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}

  <!-- Hero -->
  <section class="pt-32 pb-12 px-4 bg-[#2D2D2D] mountain-bg">
    <div class="max-w-4xl mx-auto text-center">
      <a href="/personal-insurance/" class="inline-flex items-center gap-1 text-[#B8D430] text-sm font-semibold tracking-widest uppercase hover:underline mb-4">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Personal Insurance
      </a>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">{name}</h1>
      <p class="text-[#9CA3AF] text-lg max-w-3xl mx-auto leading-relaxed">{shortDescription}</p>
      <div class="mt-8">
        <a
          href={quoteLinks.personal}
          class="inline-flex items-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg"
        >
          Get Personal Insurance
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Detailed Description -->
  <section class="py-16 px-4 bg-[#333333]">
    <div class="max-w-4xl mx-auto">
      <div class="prose prose-lg text-[#9CA3AF] leading-relaxed space-y-4">
        {detailedDescription.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Key Features & Who Needs This -->
  <section class="py-16 px-4 bg-[#2D2D2D]">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Key Features</h2>
        <div class="accent-line w-16 mb-8"></div>
        <ul class="space-y-4">
          {keyFeatures.map((feature) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#B8D430] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              <span class="text-[#9CA3AF]">{feature}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-6">Who Needs This?</h2>
        <div class="accent-line w-16 mb-8"></div>
        <ul class="space-y-4">
          {whoNeedsThis.map((item) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 text-[#B8D430] mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              <span class="text-[#9CA3AF]">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 px-4 bg-[#333333]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Ready to Get {name} Coverage?</h2>
      <p class="text-[#9CA3AF] mb-8">Call <a href="tel:303-994-7814" class="text-[#B8D430] font-semibold hover:underline">303-994-7814</a> or start your quote online.</p>
      <a
        href={quoteLinks.personal}
        class="inline-flex items-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg"
      >
        Get Personal Insurance
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <FAQ title={`${name} FAQ`} items={faq} />
  <CTABanner />
</BaseLayout>
