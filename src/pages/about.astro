---
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageMap from '../components/CoverageMap.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
import { siteConfig, quoteLinks } from '../data/siteData';

const faqItems = [
  {
    question: 'What does it mean to be an independent insurance agency?',
    answer: "It means we don't work for one insurance company — we work for you. We have access to dozens of carriers, which lets us shop around and find the best coverage at the best price for your specific needs.",
  },
{
    question: 'Why choose a veteran-owned business?',
    answer: "Military service teaches discipline, integrity, and a commitment to serving others. Patrick brings those same values to every client interaction. You can trust that we'll do what we say and follow through.",
  },
];
---

<BaseLayout
  title="About Patrick Henigan | Valor Insurance Group — Veteran-Owned Insurance Agency"
  description="Patrick Henigan is a veteran and independent insurance agent helping families and businesses in 27 states find the right coverage. Veteran owned, client focused."
>
  <!-- Hero -->
  <section class="pt-32 pb-16 px-4 bg-[#2D2D2D] mountain-bg">
    <div class="max-w-6xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-[#B8D430] text-sm font-semibold tracking-widest uppercase">Your Guide</span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">Meet Patrick Henigan</h1>
          <p class="text-[#9CA3AF] text-lg leading-relaxed mb-4">
            Patrick is a veteran, independent insurance agent, and the founder of Valor Insurance Group. After serving in the military, he brought that same sense of duty and commitment to the insurance industry — believing everyone deserves an agent who actually fights for them.
          </p>
          <p class="text-[#9CA3AF] text-lg leading-relaxed mb-6">
            Working through Direct Insurance Services, Patrick has access to dozens of top-rated carriers and is licensed in 27 states. He doesn't work for the insurance company — he works for you.
          </p>

          <!-- Trust badges -->
          <div class="flex flex-wrap gap-4 mb-8">
            <div class="flex items-center gap-2 bg-[#333333] px-4 py-2 rounded-lg border border-[#4A4A4A]">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/></svg>
              <span class="text-white text-sm font-medium">Veteran Owned</span>
            </div>
            <div class="flex items-center gap-2 bg-[#333333] px-4 py-2 rounded-lg border border-[#4A4A4A]">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span class="text-white text-sm font-medium">27 States</span>
            </div>
            <div class="flex items-center gap-2 bg-[#333333] px-4 py-2 rounded-lg border border-[#4A4A4A]">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
              <span class="text-white text-sm font-medium">Same-Day Coverage</span>
            </div>
          </div>

          <a
            href={quoteLinks.personal}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors"
          >
            Get Started
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <!-- Photo placeholder -->
        <div class="flex justify-center">
          <div class="w-80 h-96 bg-[#4A4A4A] rounded-2xl flex items-center justify-center border-2 border-[#6B6B6B]">
            <div class="text-center">
              <svg class="w-16 h-16 text-[#6B6B6B] mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>
              <p class="text-[#6B6B6B] text-sm font-medium">Patrick Henigan</p>
              <p class="text-[#6B6B6B] text-xs">Photo placeholder</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="py-20 px-4 bg-[#333333]">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">What We Stand For</h2>
      <div class="accent-line-center w-24 mx-auto mb-12"></div>
      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-[#B8D430]/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Integrity</h3>
          <p class="text-[#9CA3AF]">We tell you the truth — even when it's not what you want to hear. Your best interest always comes first.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#B8D430]/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Service</h3>
          <p class="text-[#9CA3AF]">We answer the phone. We respond to emails. We show up for you when it matters most.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-[#B8D430]/10 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/></svg>
          </div>
          <h3 class="text-white font-bold text-xl mb-2">Community</h3>
          <p class="text-[#9CA3AF]">We believe in protecting the communities we serve — not just with policies, but with genuine care and involvement.</p>
        </div>
      </div>
    </div>
  </section>

  <Testimonials />
  <CoverageMap />
  <FAQ title="About Valor Insurance Group" items={faqItems} />
  <CTABanner />
</BaseLayout>
