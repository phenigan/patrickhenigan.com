---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/siteData';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteConfig.site },
    { '@type': 'ListItem', position: 2, name: 'Personal Insurance Quote', item: `${siteConfig.site}/quote/personal/` },
  ],
};
---

<BaseLayout
  title="Get a Personal Insurance Quote | Valor Insurance Group"
  description="Request a free personal insurance quote from Patrick Henigan at Valor Insurance Group. Home, auto, umbrella, and more. Licensed in 27 states across the U.S."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <section class="pt-32 pb-8 px-4 bg-[#2D2D2D]">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-[#B8D430] text-sm font-semibold tracking-widest uppercase">Free Quote</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-4">Get a Personal Insurance Quote</h1>
      <p class="text-[#9CA3AF] text-lg max-w-2xl mx-auto leading-relaxed">
        Fill out the form below and Patrick will shop your coverage across dozens of top-rated carriers to find you the best rate.
      </p>
      <div class="flex flex-wrap justify-center gap-4 mt-6">
        <div class="flex items-center gap-2 text-[#9CA3AF] text-sm">
          <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          No obligation
        </div>
        <div class="flex items-center gap-2 text-[#9CA3AF] text-sm">
          <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Quick response
        </div>
        <div class="flex items-center gap-2 text-[#9CA3AF] text-sm">
          <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          Multiple carriers compared
        </div>
      </div>
    </div>
  </section>

  <section class="pb-20 px-4 bg-[#2D2D2D]">
    <div class="max-w-4xl mx-auto">
      <div class="bg-[#333333] rounded-2xl border border-[#4A4A4A] overflow-hidden shadow-2xl">
        <iframe
          src="https://quoteforms.app/direct-insurance-services-llc/forms/a0d430a0-8944-4589-9552-349e78539d7c/respond"
          name="Patrick Henigan Consumer Form"
          id="client-iframe"
          style="width:100%;height:80vh;border:none;"
          allow="fullscreen"
          loading="lazy"
        ></iframe>
      </div>
      <div class="text-center mt-8">
        <p class="text-[#9CA3AF] text-sm">
          Prefer to talk? Call <a href="tel:303-994-7814" class="text-[#B8D430] font-semibold hover:underline">303-994-7814</a> or
          <a href="/contact/" class="text-[#B8D430] font-semibold hover:underline">send us a message</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
