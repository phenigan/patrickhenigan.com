---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import FAQ from '../../components/FAQ.astro';
import CTABanner from '../../components/CTABanner.astro';
import { siteConfig, quoteLinks, personalInsuranceTypes, commercialInsuranceTypes } from '../../data/siteData';
import { locationDetails } from '../../data/locationData';

export function getStaticPaths() {
  return Object.values(locationDetails).map((loc) => ({
    params: { city: loc.slug },
    props: loc,
  }));
}

const { name, slug, metaDescription, intro, personalIntro, personalHighlights, commercialIntro, commercialHighlights, riskFactors, faq } = Astro.props;

const relevantPersonal = personalInsuranceTypes.filter((t) => personalHighlights.includes(t.name));
const relevantCommercial = commercialInsuranceTypes.filter((t) => commercialHighlights.includes(t.name));
const pageUrl = `${siteConfig.site}/locations/${slug}/`;
---

<BaseLayout
  title={`Insurance Agent in ${name}, CO | Valor Insurance Group`}
  description={metaDescription}
>
  <!-- LocalBusiness Schema -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Valor Insurance Group',
      telephone: siteConfig.phone,
      email: siteConfig.email,
      url: pageUrl,
      areaServed: {
        '@type': 'City',
        name: `${name}, Colorado`,
      },
      founder: {
        '@type': 'Person',
        name: siteConfig.name,
      },
    })}
  />

  <!-- Hero -->
  <section class="pt-32 pb-12 px-4 bg-[#2D2D2D] mountain-bg">
    <div class="max-w-4xl mx-auto text-center">
      <span class="text-[#B8D430] text-sm font-semibold tracking-widest uppercase">{name}, Colorado</span>
      <h1 class="text-4xl md:text-5xl font-bold text-white mt-3 mb-6">Insurance Agent in {name}, Colorado</h1>
      <p class="text-[#9CA3AF] text-lg max-w-3xl mx-auto leading-relaxed">
        {intro}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={quoteLinks.personal}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg"
        >
          Get Started
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href={`tel:${siteConfig.phone}`}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-[#B8D430] text-[#B8D430] hover:bg-[#B8D430] hover:text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          {siteConfig.phone}
        </a>
      </div>
    </div>
  </section>

  <!-- Risk Factors / Local Stats -->
  <section class="py-16 px-4 bg-[#333333]">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-8 text-center">What {name} Residents Are Up Against</h2>
      <div class="grid md:grid-cols-3 gap-6">
        {riskFactors.map((factor) => (
          <div class="bg-[#2D2D2D] rounded-lg p-6 border-l-4 border-[#B8D430]">
            <h3 class="text-white font-bold mb-1">{factor.title}</h3>
            <p class="text-[#B8D430] text-sm font-semibold mb-3">{factor.stat}</p>
            <p class="text-[#9CA3AF] text-sm leading-relaxed">{factor.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Personal Insurance -->
  <section class="py-20 px-4 bg-[#2D2D2D]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Personal Insurance in {name}</h2>
        <div class="accent-line-center w-24 mx-auto mb-6"></div>
        <p class="text-[#9CA3AF] max-w-3xl mx-auto">{personalIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relevantPersonal.map((type) => (
          <ServiceCard name={type.name} description={type.description} />
        ))}
      </div>
      <div class="text-center mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href={quoteLinks.personal}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors"
        >
          Get a Personal Quote
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/personal-insurance/" class="text-[#B8D430] hover:text-[#A6C22A] font-medium transition-colors">
          See All Personal Coverage →
        </a>
      </div>
    </div>
  </section>

  <!-- Commercial Insurance -->
  <section class="py-20 px-4 bg-[#333333]">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Business Insurance in {name}</h2>
        <div class="accent-line-center w-24 mx-auto mb-6"></div>
        <p class="text-[#9CA3AF] max-w-3xl mx-auto">{commercialIntro}</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {relevantCommercial.map((type) => (
          <ServiceCard name={type.name} description={type.description} />
        ))}
      </div>
      <div class="text-center mt-8 flex flex-col sm:flex-row gap-4 justify-center items-center">
        <a
          href={quoteLinks.commercial}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors"
        >
          Get a Business Quote
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="/commercial-insurance/" class="text-[#B8D430] hover:text-[#A6C22A] font-medium transition-colors">
          See All Commercial Coverage →
        </a>
      </div>
    </div>
  </section>

  <!-- Life Insurance -->
  <section class="py-16 px-4 bg-[#2D2D2D]">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4">Life Insurance in {name}</h2>
      <p class="text-[#9CA3AF] max-w-2xl mx-auto mb-8">
        Protect your family's future with term, whole, or universal life insurance. We help {name} residents find the right life coverage at the right price.
      </p>
      <a href="/life-insurance/" class="inline-flex items-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors">
        Explore Life Insurance
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <!-- Phone CTA -->
  <section class="py-12 px-4 bg-[#333333]">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-white text-xl font-semibold mb-2">Ready to talk about your {name} insurance?</p>
      <p class="text-[#9CA3AF] mb-6">Call Patrick directly or visit our contact page to get started.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={`tel:${siteConfig.phone}`}
          class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call {siteConfig.phone}
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center justify-center gap-2 px-8 py-4 border-2 border-[#B8D430] text-[#B8D430] hover:bg-[#B8D430] hover:text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg"
        >
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <FAQ title={`${name}, Colorado Insurance FAQ`} items={faq} />
  <CTABanner />
</BaseLayout>
