<style>
  .coverage-map-section {
    padding: 4rem 1.5rem;
    background: #1a1a2e;
  }

  .coverage-map-container {
    max-width: 960px;
    margin: 0 auto;
  }

  .coverage-map-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .coverage-map-header h2 {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 0.75rem 0;
  }

  .coverage-map-header p {
    font-size: 1.125rem;
    color: #b0b0c0;
    margin: 0;
  }

  .map-wrapper {
    position: relative;
    width: 100%;
  }

  .us-map-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .state-path {
    stroke: #6B6B6B;
    stroke-width: 1.2;
    stroke-linejoin: round;
    cursor: pointer;
    transition: opacity 0.2s ease, stroke-width 0.2s ease;
  }

  .state-path:hover {
    opacity: 0.85;
    stroke-width: 2;
    stroke: #ffffff;
  }

  .map-tooltip {
    position: absolute;
    display: none;
    background: rgba(0, 0, 0, 0.85);
    color: #ffffff;
    padding: 0.4rem 0.75rem;
    border-radius: 4px;
    font-size: 0.85rem;
    font-weight: 500;
    pointer-events: none;
    white-space: nowrap;
    z-index: 10;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  .map-legend {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #d0d0d8;
    font-size: 0.95rem;
  }

  .legend-swatch {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 3px;
  }

  .legend-licensed {
    background: #B8D430;
  }

  .legend-coming-soon {
    background: #4A4A4A;
    border: 1px solid #6B6B6B;
  }

  @media (max-width: 640px) {
    .coverage-map-section {
      padding: 2.5rem 1rem;
    }

    .coverage-map-header h2 {
      font-size: 1.5rem;
    }

    .coverage-map-header p {
      font-size: 1rem;
    }

    .map-legend {
      gap: 1.25rem;
    }

    .legend-item {
      font-size: 0.85rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tooltip = document.getElementById('map-tooltip');
    const mapWrapper = document.querySelector('.map-wrapper');
    if (!tooltip || !mapWrapper) return;

    const paths = document.querySelectorAll('.state-path');

    paths.forEach((path) => {
      const titleEl = path.querySelector('title');
      const stateName = titleEl ? titleEl.textContent : '';

      path.addEventListener('mouseenter', () => {
        if (stateName) {
          tooltip.textContent = stateName;
          tooltip.style.display = 'block';
        }
      });

      path.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = mapWrapper.getBoundingClientRect();
        const x = e.clientX - rect.left + 12;
        const y = e.clientY - rect.top - 30;
        tooltip.style.left = x + 'px';
        tooltip.style.top = y + 'px';
      });

      path.addEventListener('mouseleave', () => {
        tooltip.style.display = 'none';
      });
    });
  });
</script>
