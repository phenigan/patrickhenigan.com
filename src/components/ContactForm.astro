---
import { siteConfig, socialLinks, quoteLinks } from '../data/siteData';
---

<section class="py-20 px-4 bg-[#333333]" id="contact">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-[#B8D430] text-sm font-semibold tracking-widest uppercase">Get In Touch</span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-4">Let's Start the Conversation</h2>
      <div class="accent-line-center w-24 mx-auto mb-6"></div>
      <p class="text-[#9CA3AF] max-w-2xl mx-auto">
        Have questions? Ready to get started? Reach out and we'll get back to you within one business day.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <form class="space-y-5" id="contact-form" action="#" method="POST">
          <div class="grid sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-sm font-medium text-[#9CA3AF] mb-1.5">Full Name *</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 bg-[#2D2D2D] border border-[#4A4A4A] rounded-lg text-white placeholder-[#6B6B6B] focus:border-[#B8D430] focus:outline-none transition-colors"
                placeholder="John Smith"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-medium text-[#9CA3AF] mb-1.5">Phone Number</label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 bg-[#2D2D2D] border border-[#4A4A4A] rounded-lg text-white placeholder-[#6B6B6B] focus:border-[#B8D430] focus:outline-none transition-colors"
                placeholder="(303) 555-0100"
              />
            </div>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-[#9CA3AF] mb-1.5">Email Address *</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 bg-[#2D2D2D] border border-[#4A4A4A] rounded-lg text-white placeholder-[#6B6B6B] focus:border-[#B8D430] focus:outline-none transition-colors"
              placeholder="john@example.com"
            />
          </div>

          <div>
            <label for="insurance-type" class="block text-sm font-medium text-[#9CA3AF] mb-1.5">Insurance Type</label>
            <select
              id="insurance-type"
              name="insurance-type"
              class="w-full px-4 py-3 bg-[#2D2D2D] border border-[#4A4A4A] rounded-lg text-white focus:border-[#B8D430] focus:outline-none transition-colors"
            >
              <option value="">Select an option...</option>
              <option value="personal">Personal Insurance</option>
              <option value="commercial">Commercial / Business Insurance</option>
              <option value="life">Life Insurance</option>
              <option value="other">Not Sure / Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-medium text-[#9CA3AF] mb-1.5">Message</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-3 bg-[#2D2D2D] border border-[#4A4A4A] rounded-lg text-white placeholder-[#6B6B6B] focus:border-[#B8D430] focus:outline-none transition-colors resize-none"
              placeholder="Tell us a bit about what you're looking for..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 bg-[#B8D430] hover:bg-[#A6C22A] text-[#2D2D2D] font-bold rounded-lg transition-colors text-lg cursor-pointer"
          >
            Send Message
          </button>
        </form>
      </div>

      <!-- Contact Info -->
      <div class="space-y-8">
        <!-- Quick quote links -->
        <div class="bg-[#2D2D2D] rounded-xl p-6 border border-[#4A4A4A]">
          <h3 class="text-lg font-bold text-white mb-4">Ready to Get Started?</h3>
          <p class="text-[#9CA3AF] text-sm mb-5">Skip the form and jump straight to a coverage request:</p>
          <div class="space-y-3">
            <a
              href={quoteLinks.personal}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 px-4 py-3 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg transition-colors group"
            >
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              <span class="text-white text-sm font-medium group-hover:text-[#B8D430] transition-colors">Personal Coverage Request</span>
              <svg class="w-4 h-4 text-[#6B6B6B] ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
            <a
              href={quoteLinks.commercial}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-3 px-4 py-3 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg transition-colors group"
            >
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              <span class="text-white text-sm font-medium group-hover:text-[#B8D430] transition-colors">Business Coverage Request</span>
              <svg class="w-4 h-4 text-[#6B6B6B] ml-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </a>
          </div>
        </div>

        <!-- Direct contact -->
        <div class="space-y-4">
          <a href={siteConfig.phoneHref} class="flex items-center gap-4 group">
            <div class="w-12 h-12 bg-[#2D2D2D] rounded-lg flex items-center justify-center border border-[#4A4A4A] group-hover:border-[#B8D430] transition-colors">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            </div>
            <div>
              <p class="text-sm text-[#9CA3AF]">Call or Text</p>
              <p class="text-white font-semibold group-hover:text-[#B8D430] transition-colors">{siteConfig.phone}</p>
            </div>
          </a>

          <a href={siteConfig.emailHref} class="flex items-center gap-4 group">
            <div class="w-12 h-12 bg-[#2D2D2D] rounded-lg flex items-center justify-center border border-[#4A4A4A] group-hover:border-[#B8D430] transition-colors">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="text-sm text-[#9CA3AF]">Email</p>
              <p class="text-white font-semibold group-hover:text-[#B8D430] transition-colors">{siteConfig.email}</p>
            </div>
          </a>
        </div>

        <!-- Social links -->
        <div>
          <p class="text-sm text-[#9CA3AF] mb-3">Follow us on social media</p>
          <div class="flex gap-3">
            <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-[#2D2D2D] rounded-lg flex items-center justify-center border border-[#4A4A4A] hover:border-[#B8D430] transition-colors" aria-label="Facebook">
              <svg class="w-5 h-5 text-[#9CA3AF] hover:text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-[#2D2D2D] rounded-lg flex items-center justify-center border border-[#4A4A4A] hover:border-[#B8D430] transition-colors" aria-label="Instagram">
              <svg class="w-5 h-5 text-[#9CA3AF] hover:text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href={socialLinks.youtube1} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-[#2D2D2D] rounded-lg flex items-center justify-center border border-[#4A4A4A] hover:border-[#B8D430] transition-colors" aria-label="YouTube - Insurance in Colorado">
              <svg class="w-5 h-5 text-[#9CA3AF] hover:text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 00.5 6.19 31.6 31.6 0 000 12a31.6 31.6 0 00.5 5.81 3.02 3.02 0 002.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 002.12-2.14A31.6 31.6 0 0024 12a31.6 31.6 0 00-.5-5.81z"/><path fill="#2D2D2D" d="M9.75 15.02l6.25-3.52-6.25-3.52v7.04z"/></svg>
            </a>
            <a href={socialLinks.tiktok} target="_blank" rel="noopener noreferrer" class="w-10 h-10 bg-[#2D2D2D] rounded-lg flex items-center justify-center border border-[#4A4A4A] hover:border-[#B8D430] transition-colors" aria-label="TikTok">
              <svg class="w-5 h-5 text-[#9CA3AF] hover:text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.88-2.88 2.89 2.89 0 012.88-2.88c.28 0 .54.04.8.1v-3.5a6.37 6.37 0 00-.8-.05A6.37 6.37 0 003.12 15.3a6.37 6.37 0 006.37 6.37 6.37 6.37 0 006.37-6.37V8.84a8.2 8.2 0 004.73 1.5V6.89a4.85 4.85 0 01-1-.2z"/></svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
