---
interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  items: FAQItem[];
}

const { title = 'Frequently Asked Questions', items } = Astro.props;
---

<section class="py-20 px-4 bg-[#333333]">
  <div class="max-w-4xl mx-auto">
    <h2 class="text-3xl md:text-4xl font-bold text-white text-center mb-4">{title}</h2>
    <div class="accent-line-center w-24 mx-auto mb-12"></div>

    <div class="space-y-4" itemscope itemtype="https://schema.org/FAQPage">
      {items.map((item, i) => (
        <div
          class="bg-[#2D2D2D] rounded-lg border border-[#4A4A4A] overflow-hidden"
          itemscope
          itemprop="mainEntity"
          itemtype="https://schema.org/Question"
        >
          <button
            class="faq-toggle w-full flex items-center justify-between p-5 text-left cursor-pointer hover:bg-[#4A4A4A]/30 transition-colors"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
          >
            <span class="text-lg font-semibold text-white pr-4" itemprop="name">{item.question}</span>
            <svg class="faq-chevron w-5 h-5 text-[#B8D430] flex-shrink-0 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div
            id={`faq-answer-${i}`}
            class="faq-content hidden px-5 pb-5"
            itemscope
            itemprop="acceptedAnswer"
            itemtype="https://schema.org/Answer"
          >
            <p class="text-[#9CA3AF] leading-relaxed" itemprop="text">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.faq-toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling as HTMLElement;
      const chevron = btn.querySelector('.faq-chevron') as HTMLElement;
      const isOpen = btn.getAttribute('aria-expanded') === 'true';

      // Close all others
      document.querySelectorAll('.faq-toggle').forEach((otherBtn) => {
        if (otherBtn !== btn) {
          otherBtn.setAttribute('aria-expanded', 'false');
          (otherBtn.nextElementSibling as HTMLElement)?.classList.add('hidden');
          (otherBtn.querySelector('.faq-chevron') as HTMLElement)?.classList.remove('rotate-180');
        }
      });

      // Toggle current
      btn.setAttribute('aria-expanded', String(!isOpen));
      content.classList.toggle('hidden');
      chevron.classList.toggle('rotate-180');
    });
  });
</script>
