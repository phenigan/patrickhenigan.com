---
import { socialLinks } from '../data/siteData';

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;

// Sample video data - replace with actual video IDs
const videos = [
  { platform: 'youtube', type: 'short', id: 'dQw4w9WgXcQ', title: 'Insurance Tip: Understanding Deductibles', channel: '@InsuranceinColorado' },
  { platform: 'youtube', type: 'long', id: 'dQw4w9WgXcQ', title: 'Home Insurance 101 - Everything You Need to Know', channel: '@insurancewithpatrick' },
  { platform: 'tiktok', type: 'short', id: '7000000000000000000', title: 'Why Your Insurance Rate Went Up', channel: '@insurance.in.colorado' },
  { platform: 'youtube', type: 'short', id: 'dQw4w9WgXcQ', title: '3 Things Your Agent Should Tell You', channel: '@InsuranceinColorado' },
  { platform: 'youtube', type: 'long', id: 'dQw4w9WgXcQ', title: 'Colorado Insurance Market Update 2026', channel: '@insurancewithpatrick' },
  { platform: 'tiktok', type: 'short', id: '7000000000000000001', title: 'Bundling Actually Saves Money?', channel: '@insurance.in.colorado' },
];

const displayVideos = compact ? videos.slice(0, 4) : videos;
const platforms = ['All', 'YouTube', 'TikTok'];
---

<section class="py-20 px-4 bg-[#2D2D2D]" id="social">
  <div class="max-w-7xl mx-auto">
    <div class="text-center mb-12">
      <span class="text-[#B8D430] text-sm font-semibold tracking-widest uppercase">Follow Along</span>
      <h2 class="text-3xl md:text-4xl font-bold text-white mt-2 mb-4">Insurance Tips & Education</h2>
      <div class="accent-line-center w-24 mx-auto mb-6"></div>
      <p class="text-[#9CA3AF] max-w-2xl mx-auto">
        We believe in empowering you with knowledge. Check out our latest videos and tips on insurance, coverage, and protecting what matters.
      </p>
    </div>

    <!-- Platform filter tabs -->
    <div class="flex justify-center gap-2 mb-10">
      {platforms.map((platform) => (
        <button
          class={`filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-colors ${
            platform === 'All'
              ? 'bg-[#B8D430] text-[#2D2D2D]'
              : 'bg-[#4A4A4A] text-[#9CA3AF] hover:bg-[#6B6B6B] hover:text-white'
          }`}
          data-filter={platform.toLowerCase()}
        >
          {platform}
        </button>
      ))}
    </div>

    <!-- Video grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayVideos.map((video) => (
        <div
          class={`video-card group relative bg-[#333333] rounded-xl overflow-hidden border border-[#4A4A4A] hover:border-[#B8D430] transition-all duration-300 ${
            video.type === 'long' ? 'sm:col-span-2 lg:col-span-1' : ''
          }`}
          data-platform={video.platform}
        >
          <!-- Video facade -->
          <div class={`video-facade relative bg-[#1a1a1a] ${video.type === 'short' ? 'aspect-[9/16] max-h-80' : 'aspect-video'}`}>
            {video.platform === 'youtube' ? (
              <img
                src={`https://img.youtube.com/vi/${video.id}/mqdefault.jpg`}
                alt={video.title}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-[#1a1a1a]">
                <svg class="w-12 h-12 text-[#4A4A4A]" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.88-2.88 2.89 2.89 0 012.88-2.88c.28 0 .54.04.8.1v-3.5a6.37 6.37 0 00-.8-.05A6.37 6.37 0 003.12 15.3a6.37 6.37 0 006.37 6.37 6.37 6.37 0 006.37-6.37V8.84a8.2 8.2 0 004.73 1.5V6.89a4.85 4.85 0 01-1-.2z"/>
                </svg>
              </div>
            )}

            <!-- Play button overlay -->
            <div class="absolute inset-0 flex items-center justify-center bg-black/30 group-hover:bg-black/40 transition-colors">
              <div class="play-button w-14 h-14 bg-[#2D2D2D]/90 rounded-full flex items-center justify-center transition-all duration-300">
                <svg class="w-6 h-6 text-[#B8D430] ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
            </div>

            <!-- Platform badge -->
            <div class="absolute top-3 left-3">
              <span class={`inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-bold ${
                video.platform === 'youtube' ? 'bg-red-600 text-white' : 'bg-black text-white'
              }`}>
                {video.platform === 'youtube' ? (
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 00.5 6.19 31.6 31.6 0 000 12a31.6 31.6 0 00.5 5.81 3.02 3.02 0 002.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 002.12-2.14A31.6 31.6 0 0024 12a31.6 31.6 0 00-.5-5.81z"/><path fill="#fff" d="M9.75 15.02l6.25-3.52-6.25-3.52v7.04z"/></svg>
                ) : (
                  <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.88-2.88 2.89 2.89 0 012.88-2.88c.28 0 .54.04.8.1v-3.5a6.37 6.37 0 00-.8-.05A6.37 6.37 0 003.12 15.3a6.37 6.37 0 006.37 6.37 6.37 6.37 0 006.37-6.37V8.84a8.2 8.2 0 004.73 1.5V6.89a4.85 4.85 0 01-1-.2z"/></svg>
                )}
                {video.platform === 'youtube' ? (video.type === 'short' ? 'Short' : 'YouTube') : 'TikTok'}
              </span>
            </div>
          </div>

          <!-- Card content -->
          <div class="p-4">
            <h3 class="text-white font-semibold text-sm leading-snug mb-1">{video.title}</h3>
            <p class="text-[#9CA3AF] text-xs">{video.channel}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Social links -->
    <div class="mt-12 flex flex-wrap justify-center gap-4">
      <a href={socialLinks.youtube1} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg text-white text-sm font-medium transition-colors border border-[#4A4A4A]">
        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 00.5 6.19 31.6 31.6 0 000 12a31.6 31.6 0 00.5 5.81 3.02 3.02 0 002.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 002.12-2.14A31.6 31.6 0 0024 12a31.6 31.6 0 00-.5-5.81z"/><path fill="#fff" d="M9.75 15.02l6.25-3.52-6.25-3.52v7.04z"/></svg>
        Insurance in Colorado
      </a>
      <a href={socialLinks.youtube2} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg text-white text-sm font-medium transition-colors border border-[#4A4A4A]">
        <svg class="w-5 h-5 text-red-500" fill="currentColor" viewBox="0 0 24 24"><path d="M23.5 6.19a3.02 3.02 0 00-2.12-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.38.55A3.02 3.02 0 00.5 6.19 31.6 31.6 0 000 12a31.6 31.6 0 00.5 5.81 3.02 3.02 0 002.12 2.14c1.88.55 9.38.55 9.38.55s7.5 0 9.38-.55a3.02 3.02 0 002.12-2.14A31.6 31.6 0 0024 12a31.6 31.6 0 00-.5-5.81z"/><path fill="#fff" d="M9.75 15.02l6.25-3.52-6.25-3.52v7.04z"/></svg>
        Insurance with Patrick
      </a>
      <a href={socialLinks.tiktok} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg text-white text-sm font-medium transition-colors border border-[#4A4A4A]">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.88-2.88 2.89 2.89 0 012.88-2.88c.28 0 .54.04.8.1v-3.5a6.37 6.37 0 00-.8-.05A6.37 6.37 0 003.12 15.3a6.37 6.37 0 006.37 6.37 6.37 6.37 0 006.37-6.37V8.84a8.2 8.2 0 004.73 1.5V6.89a4.85 4.85 0 01-1-.2z"/></svg>
        TikTok
      </a>
      <a href={socialLinks.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg text-white text-sm font-medium transition-colors border border-[#4A4A4A]">
        <svg class="w-5 h-5 text-pink-500" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        Instagram
      </a>
      <a href={socialLinks.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#333333] hover:bg-[#4A4A4A] rounded-lg text-white text-sm font-medium transition-colors border border-[#4A4A4A]">
        <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        Facebook
      </a>
    </div>

    {compact && (
      <div class="text-center mt-8">
        <a href="/media/" class="inline-flex items-center gap-2 text-[#B8D430] font-semibold hover:underline">
          View All Content
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<script>
  document.querySelectorAll('.filter-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;

      // Update active button
      document.querySelectorAll('.filter-btn').forEach((b) => {
        b.classList.remove('bg-[#B8D430]', 'text-[#2D2D2D]');
        b.classList.add('bg-[#4A4A4A]', 'text-[#9CA3AF]');
      });
      btn.classList.add('bg-[#B8D430]', 'text-[#2D2D2D]');
      btn.classList.remove('bg-[#4A4A4A]', 'text-[#9CA3AF]');

      // Filter cards
      document.querySelectorAll('.video-card').forEach((card) => {
        const platform = (card as HTMLElement).dataset.platform;
        if (filter === 'all' || platform === filter) {
          (card as HTMLElement).style.display = '';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
