---
---

<section class="py-20 md:py-28 bg-[#2D2D2D]">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Content -->
      <div>
        <span class="inline-block px-4 py-1.5 bg-[#B8D430]/10 text-[#B8D430] text-sm font-bold tracking-wider uppercase rounded-full mb-6">
          Your Guide
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-6">
          Meet Patrick Henigan
        </h2>
        <p class="text-lg text-[#9CA3AF] leading-relaxed mb-10">
          As a veteran and independent insurance agent, Patrick has helped hundreds of families and businesses find the right coverage. He works for you — not the insurance company.
        </p>

        <!-- Trust Badges -->
        <div class="flex flex-col sm:flex-row flex-wrap gap-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#B8D430]/10">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M3 7l9-4 9 4M4 10v11M20 10v11M8 14v3M12 14v3M16 14v3" />
              </svg>
            </div>
            <span class="text-white font-medium text-sm">Veteran Owned<br />&amp; Operated</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#B8D430]/10">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <span class="text-white font-medium text-sm">Licensed in<br />27 States</span>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-10 h-10 flex items-center justify-center rounded-lg bg-[#B8D430]/10">
              <svg class="w-5 h-5 text-[#B8D430]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="text-white font-medium text-sm">Fast<br />Turnaround</span>
          </div>
        </div>
      </div>

      <!-- Right: Headshot Placeholder -->
      <div class="flex justify-center lg:justify-end">
        <div class="w-full max-w-md aspect-[3/4] bg-[#3a3a3a] rounded-2xl flex items-center justify-center border border-[#4a4a4a]">
          <span class="text-[#9CA3AF] text-lg font-medium">Photo</span>
        </div>
      </div>
    </div>
  </div>
</section>
