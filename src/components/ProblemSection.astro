---
---

<section class="py-20 md:py-28 bg-[#333333]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white text-center mb-14">
      Insurance Shouldn't Feel This Hard
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Card 1: Confusing Policies -->
      <div class="bg-[#2D2D2D] rounded-xl border-l-4 border-[#B8D430] p-8 shadow-lg shadow-black/20 hover:shadow-xl hover:shadow-black/30 transition-shadow duration-300">
        <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-[#B8D430]/10 mb-5">
          <svg class="w-6 h-6 text-[#B8D430]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 9a3 3 0 115.12 2.13c-.58.4-1.12.92-1.12 1.62V14" />
            <circle cx="12" cy="17" r="0.5" fill="currentColor" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Confusing Policies</h3>
        <p class="text-[#9CA3AF] leading-relaxed">
          You shouldn't need a law degree to understand your coverage.
        </p>
      </div>

      <!-- Card 2: Cookie-Cutter Coverage -->
      <div class="bg-[#2D2D2D] rounded-xl border-l-4 border-[#B8D430] p-8 shadow-lg shadow-black/20 hover:shadow-xl hover:shadow-black/30 transition-shadow duration-300">
        <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-[#B8D430]/10 mb-5">
          <svg class="w-6 h-6 text-[#B8D430]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Cookie-Cutter Coverage</h3>
        <p class="text-[#9CA3AF] leading-relaxed">
          Your life isn't one-size-fits-all. Your insurance shouldn't be either.
        </p>
      </div>

      <!-- Card 3: No One Picks Up -->
      <div class="bg-[#2D2D2D] rounded-xl border-l-4 border-[#B8D430] p-8 shadow-lg shadow-black/20 hover:shadow-xl hover:shadow-black/30 transition-shadow duration-300">
        <div class="w-12 h-12 flex items-center justify-center rounded-lg bg-[#B8D430]/10 mb-5">
          <svg class="w-6 h-6 text-[#B8D430]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            <line x1="4" y1="4" x2="20" y2="20" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-3">No One Picks Up</h3>
        <p class="text-[#9CA3AF] leading-relaxed">
          When you need help, you deserve a real person — not a phone tree.
        </p>
      </div>
    </div>
  </div>
</section>
